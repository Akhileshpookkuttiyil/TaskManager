generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  pending
  in_progress
  completed
  archived
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskRecurrence {
  none
  daily
  weekly
  monthly
}

enum NotificationType {
  due_soon
  due_today
  overdue
  task_reminder
  task_completed
  recurring_task_generated
  streak_milestone
}

enum ActivityType {
  task_created
  task_updated
  title_changed
  description_changed
  status_changed
  priority_changed
  due_date_changed
  tags_changed
  task_completed
  task_archived
  task_restored
  task_deleted
  subtask_created
  subtask_completed
  subtask_reopened
  subtask_updated
  subtask_deleted
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  avatar    String?
  tasks     Task[]
  notifications Notification[]
  activities Activity[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  status       TaskStatus   @default(pending)
  priority     TaskPriority @default(medium)
  recurrence   TaskRecurrence @default(none)
  recurrenceKey String?      @unique
  recurrenceParentId String? @db.Uuid
  recurrenceParent   Task?    @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren  Task[]   @relation("TaskRecurrence")
  parentId     String?      @db.Uuid
  parent       Task?        @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("TaskSubtasks")
  dueDate      DateTime?
  reminderDate DateTime?
  completedAt  DateTime?
  archivedAt   DateTime?
  tags         String[]     @default([])
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
  activities   Activity[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, parentId])
  @@index([parentId])
  @@index([recurrenceParentId])
}

model Notification {
  id         String            @id @default(uuid()) @db.Uuid
  type       NotificationType
  title      String
  message    String
  dedupeKey  String            @unique
  isRead     Boolean           @default(false)
  readAt     DateTime?
  taskId     String?           @db.Uuid
  task       Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId     String            @db.Uuid
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  type      ActivityType
  message   String
  taskId    String?      @db.Uuid
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([userId, taskId, createdAt])
}
