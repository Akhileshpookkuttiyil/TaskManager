{
  "name": "taskflow-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:custom": "node test_phase5_sprint2.mjs && node test_phase5_sprint3_verification.mjs && node test_phase5_sprint3_task3_3_frontend.mjs",
    "test:legacy": "node test_phase5_sprint2.mjs && node test_phase5_sprint3_verification.mjs && node test_phase5_sprint3_task3_3_frontend.mjs",
    "test:task3.3": "node test_phase5_sprint3_task3_3_frontend.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "vitest run && npm run test:custom"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.16.1",
    "date-fns": "^4.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12",
    "vitest": "^5.1.2"
  }
}
